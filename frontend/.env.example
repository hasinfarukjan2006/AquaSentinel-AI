# JalRakshak Frontend Environment Variables Example
# In production, replace this with your deployed backend API URL (e.g. https://jalrakshak-api.onrender.com or https://api.jalrakshak.org)
# If left empty or omitted, frontend will fallback to relative /api paths (useful for reverse proxies / single domain deployments).

VITE_API_BASE_URL=https://YOUR-BACKEND-URL
